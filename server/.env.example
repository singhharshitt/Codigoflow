NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/codigoflow.db
LOG_LEVEL=info

# AI / LLM (server-only — never put these in VITE_* client env)
# Key priority: NVIDIA_API_KEY → LLM_API_KEY → AI_API_KEY → LLM_API_KEY2 (failover)
# Get NVIDIA keys from https://build.nvidia.com
NVIDIA_API_KEY=
LLM_API_KEY=
LLM_API_KEY2=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_BASE_URL=
NVIDIA_MODEL=qwen/qwen2.5-coder-32b-instruct
LLM_MODEL=
NVIDIA_MAX_TOKENS=2048
NVIDIA_TEMPERATURE=0.3

# Legacy OpenAI-compatible aliases
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# GitHub (optional — raises rate limits for public repo analytics)
GITHUB_TOKEN=

# DevOps control node (Windows 11 → prefer WSL2 Ubuntu)
# auto | wsl | ssh | native
DEVOPS_EXECUTION_MODE=auto
DEVOPS_WSL_DISTRO=Ubuntu
# DEVOPS_SSH_HOST=
# DEVOPS_SSH_USER=
# DEVOPS_SSH_PORT=22
# DEVOPS_SSH_KEY_PATH=
# DEVOPS_SSH_STRICT_HOST_KEY=yes
# Absolute path of a checkout of this repo's devops/ folder on the SSH host.
# Local devops/ paths are mapped onto it (e.g. /home/ubuntu/Codigoflow/devops).
# DEVOPS_SSH_REMOTE_ROOT=
# DEVOPS_ROOT=../devops
# NAGIOS_STATUS_FILE=
# NAGIOS_COMMAND_FILE=
# NAGIOS_CFG=
# DEVOPS_TF_DESTROY_ENABLED=false
# Privileged DevOps mutations. Required in production.
# Browser clients: POST /api/auth/login with this token → HttpOnly cf_session cookie.
# CLI/automation: Authorization: Bearer <token>
# Never put this value in VITE_* frontend env vars.
# DEVOPS_API_TOKEN=change-me
# Optional dedicated cookie signing secret (defaults to DEVOPS_API_TOKEN)
# SESSION_SECRET=
# DEVOPS_REQUIRE_LOOPBACK=true
# DEVOPS_ENFORCE_TOKEN=false
# Managed GitHub import storage (default: ./data/repos)
# REPOS_STORAGE_ROOT=
# GITHUB_IMPORT_MAX_MB=500

# FastAPI Nginx deployment connector (EC2 via SSH tunnel). See docs/ec2-integration.md.
# Put machine-specific values in server/.env.local (gitignored; loaded first, wins over .env).
# Tunnel: ssh -N -L 127.0.0.1:18000:127.0.0.1:8000 codigoflow-control
# DEPLOYMENT_API_BASE_URL=http://127.0.0.1:18000
# Must equal CODIGOFLOW_API_TOKEN in backend/.env on the EC2 control node.
# CODIGOFLOW_API_TOKEN=
# Non-loopback URLs are refused unless https AND this is true (keeps the key off plain HTTP).
# DEPLOYMENT_API_ALLOW_REMOTE=false

