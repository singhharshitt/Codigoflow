NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/codigoflow.db
LOG_LEVEL=info

# NVIDIA NIM (preferred AI provider)
# Get a key from https://build.nvidia.com / NVIDIA API catalog
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen2.5-coder-32b-instruct
NVIDIA_MAX_TOKENS=2048
NVIDIA_TEMPERATURE=0.3

# Legacy OpenAI-compatible fallback (used only when NVIDIA_API_KEY is unset)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# GitHub (optional — raises rate limits for public repo analytics)
GITHUB_TOKEN=

# DevOps control node (Windows 11 → prefer WSL2 Ubuntu)
# auto | wsl | ssh | native
DEVOPS_EXECUTION_MODE=auto
DEVOPS_WSL_DISTRO=Ubuntu
# DEVOPS_SSH_HOST=
# DEVOPS_SSH_USER=
# DEVOPS_SSH_PORT=22
# DEVOPS_SSH_KEY_PATH=
# DEVOPS_ROOT=../devops

