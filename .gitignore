# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment & secrets (never commit real credentials) ─────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
credentials.json
service-account*.json

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.turbo/
*.tsbuildinfo

# Vite
.vite/
client/dist/
server/dist/

# ── Runtime data & databases ──────────────────────────────────────────────────
/data/
server/data/
devops/.plans/
devops/terraform/local-lab/generated/
devops/terraform/local-lab/.terraform/

**/*.tfstate
**/*.tfstate.*
**/*.tfplan
crash.log
crash.*.log
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*
*.pid
*.pid.lock

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/
playwright-report/
blob-report/

# ── Caches ────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm/
.node_repl_history

# ── Temporary files ───────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDE / editor (keep shared configs trackable if added later) ───────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# VS Code — ignore personal settings; allow shared recommendations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml
docker-compose.*.local.yml

# ── Local tooling / misc ──────────────────────────────────────────────────────
*.local
!*.local.example
.cursor/plans/
.cursor/agent-transcripts/
.claude/
.history/
.serverless/
.fusebox/
.dynamodb/
.tern-port
